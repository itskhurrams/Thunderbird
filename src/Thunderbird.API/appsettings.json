{
  "Data": {
    "ConnectionString": "",
    "DefaultCommandTimeOutDurationSeconds": "20"
  },
  "TokenAuthentication": {
    "SecretKey": "",
    "Issuer": "LRMISDashboardIssuer",
    "Audience": "LRMISDashboardAudience",
    "TokenPath": "/Token",
    "CookieName": "access_token",
    "ExpiryMinutes": 60
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Email": {
    "SmtpHost": "",
    "SmtpPort": 587,
    "Username": "",
    "Password": "",
    "FromAddress": "",
    "FromName": "Thunderbird",
    "EnableSsl": true
  },
  "WhatsApp": {
    "AccessToken": "",
    "PhoneNumberId": "",
    "TemplateName": "otp_verification",
    "TemplateLanguageCode": "en_US"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/thunderbird-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
